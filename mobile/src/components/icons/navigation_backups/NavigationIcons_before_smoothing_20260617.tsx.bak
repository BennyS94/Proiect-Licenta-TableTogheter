export function HomeNavIcon(props: NavigationIconProps) {
  return <NavigationPathIcon path={NAV_HOME_PATH} {...props} />;
}

export function MealPlanNavIcon(props: NavigationIconProps) {
  return <NavigationPathIcon path={NAV_MEAL_PLAN_PATH} {...props} />;
}

export function InsightsNavIcon(props: NavigationIconProps) {
  return <NavigationPathIcon path={NAV_INSIGHTS_PATH} {...props} />;
}

export function HouseholdNavIcon(props: NavigationIconProps) {
  return <NavigationPathIcon path={NAV_HOUSEHOLD_PATH} {...props} />;
}

function NavigationPathIcon({ color = "#4B5563", path, size = 26 }: NavigationIconProps & { path: string }) {
  return (
    <Svg height={size} viewBox="0 0 64 64" width={size}>
      <Path d={path} fill={color} fillRule="evenodd" />
    </Svg>
  );
}
